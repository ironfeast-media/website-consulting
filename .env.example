# Environment variables needed for the scheduling system

# Your Google Calendar ID
# Find this in Google Calendar settings under "Integrate calendar"
# GOOGLE_CALENDAR_ID=''

# OAuth2 credentials (alternative to service account)
# Use these if you cannot create a service account key. Obtain a refresh token via OAuth Playground.
# GOOGLE_CLIENT_ID='your-client-id.apps.googleusercontent.com'
# GOOGLE_CLIENT_SECRET='your-client-secret'
# GOOGLE_REFRESH_TOKEN='1//0g...'

# Site URL (usually auto-set by Netlify)
# URL='https://yourdomain.com'

# Existing variables for contact form
# EMAIL_ADDRESS='your-email@gmail.com'
# EMAIL_PASSWORD='your-app-password'
# CONTACT_FORM_HASH='your-hash'

# Netlify Emails plugin (provider: Mailgun) -- set in the Netlify UI, not here
# NETLIFY_EMAILS_PROVIDER='mailgun'
# NETLIFY_EMAILS_PROVIDER_API_KEY='your-mailgun-api-key'
# NETLIFY_EMAILS_MAILGUN_DOMAIN='ironfeast.tv'
# NETLIFY_EMAILS_MAILGUN_HOST_REGION='us'
# NETLIFY_EMAILS_SECRET='your-shared-secret'
# Where contact-form and Grant Builder lead notifications are delivered.
# CONTACT_US_EMAIL='ana@ironfeast.tv'

# Grant Opportunity Prompt Builder
# Canonical origin, used for absolute links and canonical tags.
# SITE_BASE='https://ironfeast.org'
# Hostnames that should serve the builder at "/" instead of the homepage.
# Leave unset until a builder subdomain exists; then this is the only change needed.
# BUILDER_HOSTS='builder.ironfeast.org,prompt.ironfeast.org'
# Sender for both Grant Builder emails. Must be on a domain verified with Mailgun --
# currently ironfeast.tv, which is why this is not an @ironfeast.org address.
# Change once ironfeast.org is verified with Mailgun.
# BUILDER_MAIL_FROM='contactus@ironfeast.tv'
# Where Grant Builder lead notifications land. Falls back to CONTACT_US_EMAIL.
# BUILDER_LEAD_TO='ana@ironfeast.tv'
# The Mailgun domain in use is a sandbox, which only delivers to authorized
# recipients -- so the visitor confirmation is OFF by default. Set to 'true'
# only once a real domain is verified with Mailgun.
# BUILDER_SEND_CONFIRMATION='false'
