# Environment variables needed for the scheduling system

# Google Calendar API Credentials (Service Account JSON)
# Get this from Google Cloud Console after creating a service account
# Replace with your actual service account credentials
GOOGLE_CALENDAR_CREDENTIALS='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Your Google Calendar ID
# Find this in Google Calendar settings under "Integrate calendar"
GOOGLE_CALENDAR_ID='your-calendar-id@group.calendar.google.com'

# Site URL (usually auto-set by Netlify)
# URL='https://yourdomain.com'

# Existing variables for contact form
# EMAIL_ADDRESS='your-email@gmail.com'
# EMAIL_PASSWORD='your-app-password'
# CONTACT_FORM_HASH='your-hash'
