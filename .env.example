# Environment variables needed for the scheduling system

# Your Google Calendar ID
# Find this in Google Calendar settings under "Integrate calendar"
# GOOGLE_CALENDAR_ID=''

# OAuth2 credentials (alternative to service account)
# Use these if you cannot create a service account key. Obtain a refresh token via OAuth Playground.
# GOOGLE_CLIENT_ID='your-client-id.apps.googleusercontent.com'
# GOOGLE_CLIENT_SECRET='your-client-secret'
# GOOGLE_REFRESH_TOKEN='1//0g...'

# Site URL (usually auto-set by Netlify)
# URL='https://yourdomain.com'

# Existing variables for contact form
# EMAIL_ADDRESS='your-email@gmail.com'
# EMAIL_PASSWORD='your-app-password'
# CONTACT_FORM_HASH='your-hash'

# Grant Opportunity Prompt Builder
# Canonical origin, used for absolute links and canonical tags.
# SITE_BASE='https://ironfeast.org'
# Hostnames that should serve the builder at "/" instead of the homepage.
# Leave unset until a builder subdomain exists; then this is the only change needed.
# BUILDER_HOSTS='builder.ironfeast.org,prompt.ironfeast.org'
