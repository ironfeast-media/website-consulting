<script>
// ── MODE STATE ─────────────────────────────────────────────────
let currentMode = 'np';

function setMode(mode) {
  currentMode = mode;
  document.body.classList.toggle('fp-mode', mode === 'fp');

  // toggle active class
  document.getElementById('btn-np').className = 'mode-btn' + (mode==='np' ? ' active-np' : '');
  document.getElementById('btn-fp').className = 'mode-btn' + (mode==='fp' ? ' active-fp' : '');

  // update CSS accent vars
  const r = document.documentElement.style;
  if (mode === 'fp') {
    r.setProperty('--accent',    '#059669');
    r.setProperty('--accentDim', '#d1fae5');
    r.setProperty('--accentGlow','rgba(5,150,105,0.15)');
    r.setProperty('--headerA',   '#2c3e50');
    r.setProperty('--headerB',   '#2a5348');
    r.setProperty('--headerC',   '#16a085');
  } else {
    r.setProperty('--accent',    '#2563eb');
    r.setProperty('--accentDim', '#dbeafe');
    r.setProperty('--accentGlow','rgba(37,99,235,0.15)');
    r.setProperty('--headerA',   '#2c3e50');
    r.setProperty('--headerB',   '#2c4a63');
    r.setProperty('--headerC',   '#3498db');
  }

  // update dynamic text
  document.getElementById('hdr-eyebrow').textContent = mode === 'fp'
    ? 'For-profit grant research · v3.0'
    : 'Nonprofit grant research · v3.0';
  document.getElementById('hdr-desc').textContent = mode === 'fp'
    ? 'Tell us about your company and we will write the prompt for you. It is tuned for SBIR/STTR, federal R&D money, state economic development programs and corporate innovation funds.'
    : 'Tell us about your organization and we will write the prompt for you. Paste it into whichever AI you already use and you get back a ranked list of funders worth your time.';
  document.getElementById('mode-label').textContent = mode === 'fp'
    ? 'SBIR/STTR, federal R&D, state economic development & corporate innovation'
    : 'Foundations, government, corporate grants & giving programs';

  // field label updates
  document.getElementById('lbl-budget').textContent = mode === 'fp' ? 'Annual Revenue (USD)' : 'Annual Budget (USD)';
  document.getElementById('lbl-geo').textContent    = mode === 'fp' ? 'Primary Business Location' : 'Service Area';
  document.getElementById('sec-focus-title').textContent = mode === 'fp' ? 'Market & Industry Focus' : 'Who You Serve & What You Do';
  document.getElementById('focus-icon').textContent = mode === 'fp' ? '📈' : '🎯';
  document.getElementById('lbl-issues').textContent = mode === 'fp' ? 'Industry / Technology Focus Areas' : 'Focus / Issue Areas';
  document.getElementById('lbl-keywords').textContent = mode === 'fp' ? 'Product / Technology Keywords' : 'Program Keywords';
  document.getElementById('lbl-past').textContent   = mode === 'fp' ? 'Current / Past Grants Won (AI will avoid duplicating)' : 'Current / Past Funders (AI will avoid duplicating)';
  document.getElementById('lbl-capacity').textContent = mode === 'fp' ? 'Application / BD Capacity' : 'Application Capacity';
  document.getElementById('sec-fin-title').textContent = mode === 'fp' ? 'Financial & Funding Criteria' : 'Financial & Operational Criteria';

  // org phase options
  const phaseEl = document.getElementById('orgPhase');
  const fpPhases = ['pre-revenue startup','early-stage with some revenue','growth stage','mature / established'];
  const npPhases = ['startup (0–2 yrs)','pilot / proof of concept','scaling','mature / established'];
  const phases = mode === 'fp' ? fpPhases : npPhases;
  phaseEl.innerHTML = phases.map((p,i) => `<option value="${p}"${i===2?' selected':''}>${p.charAt(0).toUpperCase()+p.slice(1)}</option>`).join('');
}

// ── TAB MANAGEMENT ─────────────────────────────────────────────
function showTab(name, btn) {
  ['build','prompt','guide'].forEach(t => {
    document.getElementById('tab-'+t).style.display = t===name ? 'block' : 'none';
  });
  document.querySelectorAll('.tab-btn').forEach((b,i) => {
    b.classList.toggle('active', b===btn || (btn===null && ['build','prompt','guide'][i]===name));
  });
  if (btn===null) {
    const idx = ['build','prompt','guide'].indexOf(name);
    if (idx >= 0) document.querySelectorAll('.tab-btn')[idx].classList.add('active');
  }
}

// ── PILL TOGGLES ───────────────────────────────────────────────
function togglePill(el, color) {
  const cls = 'active-'+color;
  el.classList.toggle(cls);
}
function getPills(group) {
  return [...document.querySelectorAll(`.pill[data-group="${group}"][class*="active-"]`)]
    .map(p => p.dataset.val);
}

// ── TAG INPUTS ─────────────────────────────────────────────────
function addTag(key) {
  const inputMap = { issueAreas:'issueAreasInp', keywords:'keywordsInp' };
  const inp = document.getElementById(inputMap[key]);
  if (!inp) return;
  const val = inp.value.trim().replace(/,$/, '');
  if (!val) return;
  const hidden = document.getElementById(key);
  const existing = hidden.value ? hidden.value.split(',').map(t=>t.trim()).filter(Boolean) : [];
  if (existing.includes(val)) { inp.value=''; return; }
  existing.push(val);
  hidden.value = existing.join(', ');
  renderTags(key, existing);
  inp.value = '';
}
function removeTag(key, val) {
  const hidden = document.getElementById(key);
  const existing = hidden.value.split(',').map(t=>t.trim()).filter(t=>t && t!==val);
  hidden.value = existing.join(', ');
  renderTags(key, existing);
}
function renderTags(key, tags) {
  const c = document.getElementById(key+'-tags');
  if (c) c.innerHTML = tags.map(t =>
    `<span class="tag-chip">${t}<span class="tag-x" onclick="removeTag('${key}','${CSS.escape(t)}')">×</span></span>`
  ).join('');
}
document.addEventListener('DOMContentLoaded', () => {
  [['issueAreasInp','issueAreas'],['keywordsInp','keywords']].forEach(([inpId, key]) => {
    const el = document.getElementById(inpId);
    if (el) el.addEventListener('keydown', e => {
      if (e.key==='Enter'||e.key===',') { e.preventDefault(); addTag(key); }
    });
  });
});

// ── HELPERS ────────────────────────────────────────────────────
function v(id) { const el = document.getElementById(id); return el ? el.value.trim() : ''; }
function chk(id) { const el = document.getElementById(id); return el ? el.checked : false; }

// ── BUILD PROMPT ───────────────────────────────────────────────
function buildPrompt() {
  const fp = currentMode === 'fp';
  const scopeLabels = { local:'Local/City', county:'County-wide', state:'Statewide', regional:'Multi-State Regional', national:'National', international:'International' };
  const lines = [];

  // ─ ROLE ─
  lines.push(`## ROLE`);
  if (fp) {
    lines.push(`You are an expert grant consultant and innovation funding specialist with 20+ years of experience helping for-profit companies — from early-stage startups to established SMEs — identify and win non-dilutive government grants, federal R&D contracts, state economic development awards, and corporate innovation programs. You have deep knowledge of SBIR/STTR programs across all federal agencies (NIH, DOE, NSF, DOD, NASA, USDA, DHS), SBA resources, Grants.gov, SAM.gov, state-level innovation funds, and corporate accelerator/grant programs. You prioritize quality, verified matches and flag uncertainty honestly.`);
  } else {
    lines.push(`You are an expert institutional fundraiser and grant research specialist with 20+ years of experience matching nonprofits and social-sector organizations to funders. You have deep familiarity with Candid's Philanthropy Classification System (PCS), Grants.gov, Instrumentl, JustFund, and GrantStation databases. You prioritize quality matches over volume and flag uncertainty honestly.`);
  }
  lines.push(``, `---`, ``);

  // ─ ORG CONTEXT ─
  lines.push(`## MY ORGANIZATION`);
  if (v('orgName')) lines.push(`- **Name:** ${v('orgName')}`);

  if (fp) {
    if (v('bizDesc'))      lines.push(`- **Business Description:** ${v('bizDesc')}`);
    if (v('bizStructure')) lines.push(`- **Business Structure:** ${v('bizStructure')}`);
    if (v('ownership'))    lines.push(`- **Ownership / Certifications:** ${v('ownership')}`);
    if (v('naics'))        lines.push(`- **Industry / NAICS:** ${v('naics')}`);
    if (v('trl') && v('trl') !== 'Not applicable') lines.push(`- **Technology Readiness Level:** ${v('trl')}`);
  } else {
    if (v('mission'))      lines.push(`- **Mission:** ${v('mission')}`);
    lines.push(`- **Tax Status:** ${v('taxStatus')}`);
    const fs = v('fiscalSponsor');
    if (fs === 'yes') lines.push(`- **Fiscal Sponsor:** Yes — only include funders that accept fiscally sponsored organizations`);
    if (fs === 'transitioning') lines.push(`- **Fiscal Sponsor:** In transition`);
  }

  if (v('orgAge'))    lines.push(`- **Years Operating:** ${v('orgAge')}`);
  lines.push(`- **Phase:** ${v('orgPhase')}`);
  if (v('budget'))    lines.push(`- **${fp ? 'Annual Revenue' : 'Annual Budget'}:** $${v('budget')}`);
  if (v('staffSize')) lines.push(`- **Team Size:** ${v('staffSize')}`);
  if (v('geography')) lines.push(`- **${fp ? 'Primary Location' : 'Geographic Service Area'}:** ${v('geography')}`);
  lines.push(`- **Geographic Scope of Funding Needed:** ${scopeLabels[v('geoScope')] || v('geoScope')}`);
  lines.push(``);

  // ─ FOCUS ─
  lines.push(fp ? `## MARKET & TECHNOLOGY FOCUS` : `## WHO WE SERVE & WHAT WE DO`);
  if (fp && v('targetMarket')) lines.push(`- **Target Market / Customer:** ${v('targetMarket')}`);
  if (!fp && v('population'))  lines.push(`- **Target Population:** ${v('population')}`);
  const issueAreas = v('issueAreas');
  const keywords   = v('keywords');
  if (issueAreas) lines.push(`- **${fp ? 'Industry / Technology Areas' : 'Issue Areas (PCS-aligned)'}:** ${issueAreas}`);
  if (keywords)   lines.push(`- **${fp ? 'Product / Technology Keywords' : 'Program Keywords'}:** ${keywords}`);
  const emerging = fp ? getPills('fp-emerging').join(', ') : getPills('emerging').join(', ');
  if (emerging)   lines.push(`- **Priority Categories:** ${emerging}`);
  lines.push(``);

  // ─ CRITERIA ─
  lines.push(`## FUNDING SEARCH CRITERIA`);
  if (v('grantMin') || v('grantMax')) {
    const parts = [];
    if (v('grantMin')) parts.push(`minimum $${v('grantMin')}`);
    if (v('grantMax')) parts.push(`maximum $${v('grantMax')}`);
    lines.push(`- **Amount Range:** ${parts.join(' — ')}`);
  }
  lines.push(`- **Deadline Lead Time Required:** At least ${v('daysOut')} days from today`);

  const funderTypes   = fp ? getPills('fp-funderTypes').join(', ') : getPills('funderTypes').join(', ');
  const supportTypes  = fp ? getPills('fp-supportTypes').join(', ') : getPills('supportTypes').join(', ');
  if (funderTypes)  lines.push(`- **Preferred ${fp ? 'Funding Sources' : 'Funder Types'}:** ${funderTypes}`);
  if (supportTypes) lines.push(`- **${fp ? 'Use of Funds' : 'Support Type'}:** ${supportTypes}`);
  lines.push(`- **Multi-Year Preference:** ${v('multiYear')}`);
  lines.push(`- **Application Burden Tolerance:** ${v('appBurden')}`);

  if (fp) {
    if (v('dilution'))  lines.push(`- **Dilution Tolerance:** ${v('dilution')}`);
    if (chk('nonDilutiveOnly')) lines.push(`- **Funding Constraint:** Non-dilutive only — exclude equity-requiring programs`);
  } else {
    if (v('indirectRate')) lines.push(`- **Indirect Cost Rate Needed:** ${v('indirectRate')}% — flag any funders that cap below this`);
    if (chk('openToNew')) lines.push(`- **New Grantee Preference:** Prioritize funders with evidence of accepting new/first-time grantees`);
  }
  if (v('matchCapacity')) lines.push(`- **Matching / Cost-Share Capacity:** ${v('matchCapacity')}`);
  if (v('restrictions'))  lines.push(`- **Restrictions / Ineligible Uses:** ${v('restrictions')}`);
  lines.push(``);

  // ─ ADDITIONAL CONTEXT ─
  const hasCtx = v('goodFitExamples') || v('pastGrantors') || v('urgency') || v('appCapacity') || v('extras');
  if (hasCtx) {
    lines.push(`## ADDITIONAL CONTEXT`);
    if (v('goodFitExamples')) lines.push(`- **Good-Fit Examples (calibration):** ${v('goodFitExamples')}`);
    if (v('pastGrantors'))    lines.push(`- **Past Funders / Awards (avoid duplicating):** ${v('pastGrantors')}`);
    if (v('urgency'))         lines.push(`- **Priority Use / Urgency:** ${v('urgency')}`);
    if (v('appCapacity'))     lines.push(`- **Application Capacity:** ${v('appCapacity')}`);
    if (v('extras'))          lines.push(`- **Other Context:** ${v('extras')}`);
    lines.push(``);
  }

  // ─ CHAIN OF THOUGHT ─
  lines.push(`## REASONING INSTRUCTION (Chain-of-Thought)`);
  lines.push(`Work through this step by step before generating your final list:`);
  lines.push(`1. **Geography filter** — eliminate any program that doesn't cover my location or allow remote/national applicants`);
  lines.push(`2. **Eligibility filter** — eliminate programs where my ${fp ? 'business structure, size, or NAICS code' : 'org type, tax status, or budget'} is ineligible`);
  if (fp) {
    lines.push(`3. **Technology fit** — assess how closely my technology domain, TRL level, and market match each program's scope (score 1–10)`);
    lines.push(`4. **Financial fit** — flag any program with cost-share requirements beyond my stated capacity, or equity requirements if non-dilutive only`);
    lines.push(`5. **Access assessment** — note application entry point (solicitation, continuous open BAA, state portal), cycle timing, and typical award timeline`);
  } else {
    lines.push(`3. **Mission alignment** — score each funder on how closely their stated priorities match my mission (1–10)`);
    lines.push(`4. **Financial fit** — flag any funder with indirect cost caps below my stated rate or matching requirements I cannot meet`);
    lines.push(`5. **Access assessment** — note whether the funder accepts new grantees and what the entry point is (LOI, full proposal, or online form)`);
  }
  lines.push(`6. **Final ranking** — rank by combined fit score and practical feasibility`);
  lines.push(``);

  // ─ OUTPUT FORMAT ─
  lines.push(`## REQUIRED OUTPUT FORMAT`);
  lines.push(`Provide a table with these exact columns:`);
  lines.push(``);
  lines.push(`| ${fp ? 'Program / Agency' : 'Funder Name'} | ${fp ? 'Solicitation / Program Name' : 'Program Name'} | Award Range | Deadline / Cycle | Where to Find It | ${fp ? 'Funding Type' : 'Support Type'} | Fit Score (1–10) | Why It Fits | Flags / Cautions |`);
  lines.push(`|---|---|---|---|---|---|---|---|---|`);
  lines.push(``);
  lines.push(`After the table, provide:`);
  lines.push(`**A. Top 3 ${fp ? 'Funding Source Categories' : 'Funder Categories'} to Prioritize** — best-suited types for my profile`);
  lines.push(`**B. Top 5 Search Keywords** — terms to use when searching ${fp ? 'SBIR.gov, Grants.gov, SAM.gov, and state portals' : 'Candid, Instrumentl, or GrantStation'}`);
  lines.push(`**C. Red Flags to Watch** — programs or funding types to avoid given my profile`);
  lines.push(``);

  // ─ VERIFICATION ─
  lines.push(`## VERIFICATION STEP (Anti-Hallucination)`);
  lines.push(`Before finalizing:`);
  lines.push(`- Remove any entry where you are **less than 80% confident** it exists and accepts my type of ${fp ? 'company' : 'organization'}`);
  lines.push(`- For entries 80–95% confident, add to Flags: "(Verify: [specific thing to confirm])"`);
  lines.push(`- 8 high-confidence matches beats 15 uncertain ones`);
  lines.push(`- If you used web search, cite the source URL for any deadline or award range retrieved from a live page`);
  if (fp) lines.push(`- For SBIR/STTR, always note the specific agency and topic number if known`);

  return lines.join('\n');
}

// ── GENERATE & DISPLAY ─────────────────────────────────────────
function generatePrompt() {
  const text = buildPrompt();
  document.getElementById('prompt-text').textContent = text;
  const lines = text.split('\n').length;
  const modeLabel = currentMode === 'fp' ? 'FOR-PROFIT' : 'NONPROFIT';
  document.getElementById('prompt-meta').textContent = `${modeLabel} · ${lines} LINES · 5 LAYERS`;
  document.getElementById('prompt-empty').style.display = 'none';
  document.getElementById('prompt-output').style.display = 'block';
  showTab('prompt', document.querySelectorAll('.tab-btn')[1]);
}

// ── COPY ───────────────────────────────────────────────────────
function copyPrompt() {
  const text = document.getElementById('prompt-text').textContent;
  navigator.clipboard.writeText(text).then(() => {
    ['copy-top','copy-big'].forEach(id => {
      const btn = document.getElementById(id);
      btn.textContent = '✓ COPIED!';
      btn.classList.replace('idle','done');
    });
    setTimeout(() => {
      document.getElementById('copy-top').textContent = '📋 COPY';
      document.getElementById('copy-top').classList.replace('done','idle');
      document.getElementById('copy-big').textContent = '📋 Copy Prompt';
      document.getElementById('copy-big').classList.replace('done','idle');
    }, 2500);
  });
}

// ── RESET ──────────────────────────────────────────────────────
function resetForm() {
  document.querySelectorAll('input[type=text], textarea').forEach(el => el.value = '');
  document.querySelectorAll('select').forEach(el => el.selectedIndex = 0);
  ['openToNew','nonDilutiveOnly'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.checked = id === 'openToNew';
  });
  document.querySelectorAll('.pill').forEach(p => p.className = 'pill');
  ['issueAreas','keywords'].forEach(key => {
    const h = document.getElementById(key);
    if (h) h.value = '';
    const t = document.getElementById(key+'-tags');
    if (t) t.innerHTML = '';
  });
  document.getElementById('prompt-empty').style.display = 'block';
  document.getElementById('prompt-output').style.display = 'none';
  showTab('build', document.querySelectorAll('.tab-btn')[0]);
}

// ── DEFAULT MODE: FOR-PROFIT ───────────────────────────────────
// Ironfeast is positioned around SBIR/STTR, so the tool opens on
// the For-Profit side. Nonprofit stays one click away.
// setMode() already handles the button classes, body class, accent
// vars and phase options, so this is the whole change.
document.addEventListener('DOMContentLoaded', () => setMode('fp'));
</script>

