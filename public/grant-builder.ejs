<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grant Opportunity Prompt Builder v3.0</title>
<meta name="description" content="A free tool from Ironfeast Consulting that writes you an AI prompt for finding grants your organization actually qualifies for.">
<link rel="canonical" href="<%= siteBase %>/grant-builder">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;600;700&display=swap">
<style>

  :root {
    --bg: #f4f6fa;
    --surface: #ffffff;
    --surfaceB: #f0f3f9;
    --border: #dce2ee;
    --borderB: #c8d0e4;
    --blue: #2563eb;
    --blueDim: #dbeafe;
    --blueGlow: rgba(37,99,235,0.15);
    --green: #15803d;
    --greenDim: #dcfce7;
    --gold: #92620a;
    --goldDim: #fef3c7;
    --red: #dc2626;
    --amber: #b45309;
    --text: #1e2a3a;
    --muted: #52647a;
    --faint: #a0afc0;
    --mono: 'JetBrains Mono', 'Courier New', monospace;
    --serif: 'Lora', Georgia, serif;
    /* mode accent — overridden by JS */
    --accent: #2563eb;
    --accentDim: #dbeafe;
    --accentGlow: rgba(37,99,235,0.15);
    --headerA: #2c3e50;
    --headerB: #2c4a63;
    --headerC: #3498db;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: var(--serif); min-height: 100vh; padding-bottom: 60px; }

  /* ── header ── */
  .header { background: linear-gradient(135deg, var(--headerA) 0%, var(--headerB) 60%, var(--headerC) 100%); border-bottom: 1px solid rgba(0,0,0,.15); padding: 32px 32px 26px; transition: background .4s; }
  .header-inner { max-width: 860px; margin: 0 auto; }
  .eyebrow { font-family: var(--mono); font-size: 10px; color: rgba(255,255,255,.7); letter-spacing: .18em; text-transform: uppercase; margin-bottom: 8px; }
  .header h1 { font-size: 28px; font-weight: 700; line-height: 1.2; margin-bottom: 8px; color: #fff; }
  .header h1 span { color: rgba(255,255,255,.65); font-weight: 400; }
  .header p { color: rgba(255,255,255,.82); font-size: 14px; line-height: 1.65; max-width: 580px; }
  .hbadges { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .hbadge { font-family: var(--mono); font-size: 10px; border-radius: 12px; padding: 3px 10px; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.38); color: #fff; }

  /* ── org type toggle ── */
  .mode-toggle-wrap { max-width: 860px; margin: 0 auto; padding: 20px 24px 0; }
  .mode-toggle { display: inline-flex; background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 4px; box-shadow: 0 1px 4px rgba(0,0,0,.07); gap: 4px; }
  .mode-btn { font-family: var(--mono); font-size: 13px; font-weight: 700; padding: 10px 24px; border: none; border-radius: 9px; cursor: pointer; transition: all .2s; letter-spacing: .02em; background: transparent; color: var(--muted); }
  .mode-btn.active-np  { background: linear-gradient(135deg, #1e3a8a, #2563eb); color: #fff; box-shadow: 0 2px 10px rgba(37,99,235,.25); }
  .mode-btn.active-fp  { background: linear-gradient(135deg, #064e3b, #059669); color: #fff; box-shadow: 0 2px 10px rgba(5,150,105,.25); }
  .mode-label { font-family: var(--serif); font-size: 13px; color: var(--muted); margin-left: 14px; align-self: center; font-style: italic; }

  /* ── layout ── */
  .main { max-width: 860px; margin: 0 auto; padding: 18px 24px 0; }

  /* ── tabs ── */
  .tabs { display: flex; gap: 4px; margin-bottom: 22px; background: #fff; border-radius: 12px; padding: 4px; border: 1px solid var(--border); box-shadow: 0 1px 4px rgba(0,0,0,.06); }
  .tab-btn { flex: 1; background: transparent; border: none; border-radius: 8px; color: var(--muted); font-family: var(--mono); font-size: 12px; font-weight: 600; padding: 10px 14px; cursor: pointer; transition: all .18s; }
  .tab-btn:hover { background: var(--surfaceB); color: var(--text); }
  .tab-btn.active { background: var(--accent); color: #fff; box-shadow: 0 2px 8px var(--accentGlow); }

  /* ── sections ── */
  .section { margin-bottom: 18px; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.05); }
  .section-head { background: linear-gradient(90deg, var(--accentDim) 0%, #f8faff 100%); padding: 12px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
  .section-title { font-family: var(--mono); font-size: 12px; font-weight: 700; color: var(--accent); flex: 1; letter-spacing: .03em; }
  .section-badge { font-family: var(--mono); font-size: 10px; background: var(--goldDim); color: var(--gold); border-radius: 10px; padding: 2px 8px; font-weight: 700; }
  .section-body { padding: 18px 20px; background: var(--surface); }

  /* ── grid ── */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
  @media(max-width: 620px) { .grid-2,.grid-3 { grid-template-columns: 1fr; } }

  /* ── fields ── */
  .field { margin-bottom: 16px; }
  .field label { display: block; font-family: var(--mono); font-size: 10px; color: var(--accent); letter-spacing: .12em; text-transform: uppercase; margin-bottom: 4px; font-weight: 700; }
  .field .hint { font-size: 11px; color: var(--muted); margin-bottom: 5px; font-style: italic; }
  input[type=text], select, textarea {
    width: 100%; background: var(--surfaceB); border: 1px solid var(--border);
    border-radius: 8px; color: var(--text); font-family: var(--serif); font-size: 14px;
    padding: 9px 13px; outline: none; transition: border-color .2s, box-shadow .2s; -webkit-appearance: none;
  }
  input[type=text]:focus, select:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accentGlow); background: #fff; }
  textarea { resize: vertical; line-height: 1.6; }
  select { cursor: pointer; }

  /* ── pills ── */
  .pills { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 4px; }
  .pill { background: var(--surfaceB); border: 1px solid var(--border); border-radius: 20px; color: var(--muted); font-family: var(--mono); font-size: 11px; padding: 5px 13px; cursor: pointer; transition: all .15s; user-select: none; }
  .pill:hover { border-color: var(--accent); color: var(--accent); background: var(--accentDim); }
  .pill.active-blue  { background: #dbeafe; border-color: #93c5fd; color: #1d4ed8; font-weight: 700; }
  .pill.active-green { background: #d1fae5; border-color: #6ee7b7; color: #065f46; font-weight: 700; }
  .pill.active-amber { background: #fef9c3; border-color: #fde68a; color: #92400e; font-weight: 700; }
  .pill.active-teal  { background: #ccfbf1; border-color: #5eead4; color: #0f766e; font-weight: 700; }

  /* ── tag input ── */
  .tag-row { display: flex; gap: 8px; margin-bottom: 8px; }
  .tag-add-btn { background: var(--accentDim); border: 1px solid var(--accent); border-radius: 8px; color: var(--accent); padding: 9px 14px; cursor: pointer; font-family: var(--mono); font-size: 12px; font-weight: 700; white-space: nowrap; transition: opacity .15s; }
  .tag-add-btn:hover { opacity: .8; }
  .tags-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag-chip { background: var(--accentDim); border: 1px solid var(--accent); opacity: .7; color: var(--accent); border-radius: 20px; padding: 3px 10px 3px 12px; font-size: 12px; font-family: var(--mono); display: inline-flex; align-items: center; gap: 6px; }
  .tag-x { cursor: pointer; color: var(--faint); font-weight: 700; font-size: 14px; }
  .tag-x:hover { color: var(--red); }

  /* ── checkbox ── */
  .check-row { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
  .check-row input { width: 16px; height: 16px; accent-color: var(--accent); cursor: pointer; flex-shrink: 0; }
  .check-row label { font-family: var(--mono); font-size: 12px; color: var(--muted); cursor: pointer; }

  /* ── action buttons ── */
  .btn-row { display: flex; gap: 12px; margin-top: 8px; padding-bottom: 20px; }
  .btn-primary { flex: 1; background: linear-gradient(135deg, var(--headerA) 0%, var(--accent) 100%); border: none; border-radius: 10px; color: #fff; font-family: var(--mono); font-size: 14px; font-weight: 700; padding: 15px 24px; cursor: pointer; letter-spacing: .04em; box-shadow: 0 4px 14px var(--accentGlow); transition: all .15s; }
  .btn-primary:hover { opacity: .9; }
  .btn-reset { background: #fff; border: 1px solid var(--border); border-radius: 10px; color: var(--muted); font-family: var(--mono); font-size: 13px; padding: 15px 18px; cursor: pointer; transition: all .15s; }
  .btn-reset:hover { color: var(--text); border-color: var(--borderB); }

  /* ── prompt output ── */
  .layer-badges { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
  .lbadge { font-family: var(--mono); font-size: 10px; border-radius: 10px; padding: 3px 10px; }
  .prompt-box { background: #fff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 16px; box-shadow: 0 1px 6px rgba(0,0,0,.06); }
  .prompt-topbar { padding: 11px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; background: linear-gradient(90deg, var(--accentDim) 0%, #f8faff 100%); }
  .prompt-label { font-family: var(--mono); font-size: 11px; color: var(--accent); font-weight: 700; letter-spacing: .08em; }
  .btn-copy { border-radius: 7px; font-family: var(--mono); font-size: 11px; font-weight: 700; padding: 5px 14px; cursor: pointer; transition: all .2s; }
  .btn-copy.idle { background: var(--accentDim); border: 1px solid var(--accent); color: var(--accent); }
  .btn-copy.done { background: #d1fae5; border: 1px solid #6ee7b7; color: #065f46; }
  pre.prompt-pre { margin: 0; padding: 22px; font-family: var(--mono); font-size: 11.5px; line-height: 1.8; color: #1e3a5f; white-space: pre-wrap; word-break: break-word; max-height: 500px; overflow-y: auto; background: #f8faff; }
  .copy-row { display: flex; gap: 10px; }
  .btn-back { background: #fff; border: 1px solid var(--border); border-radius: 9px; color: var(--muted); font-family: var(--mono); font-size: 12px; padding: 11px 18px; cursor: pointer; }
  .btn-copy-big { flex: 1; border-radius: 9px; font-family: var(--mono); font-size: 13px; font-weight: 700; padding: 11px 20px; cursor: pointer; transition: all .2s; }
  .btn-copy-big.idle { background: linear-gradient(135deg, var(--headerA), var(--accent)); border: 1px solid transparent; color: #fff; }
  .btn-copy-big.done { background: #d1fae5; border: 1px solid #6ee7b7; color: #065f46; }

  /* ── empty state ── */
  .empty { text-align: center; padding: 60px 40px; border: 2px dashed var(--border); border-radius: 12px; color: var(--muted); background: #fff; }
  .empty .emoji { font-size: 40px; margin-bottom: 12px; }
  .empty p { font-family: var(--mono); font-size: 13px; }

  /* ── guide ── */
  .guide-card { margin-bottom: 14px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
  .guide-head { padding: 10px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
  .guide-body { padding: 14px 18px; background: var(--surface); font-size: 13px; color: var(--muted); line-height: 1.75; }
  .tips-box { background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 16px 20px; margin-top: 8px; }
  .tips-label { font-family: var(--mono); font-size: 11px; color: var(--gold); margin-bottom: 10px; font-weight: 700; }
  .tip-row { display: flex; gap: 10px; margin-bottom: 8px; font-size: 13px; color: #4a3b1a; line-height: 1.6; }
  .tip-num { color: var(--accent); font-family: var(--mono); font-size: 12px; min-width: 20px; font-weight: 700; }

  /* ── FP-only / NP-only visibility ── */
  .fp-only { display: none; }
  .np-only { display: block; }
  body.fp-mode .fp-only { display: block; }
  body.fp-mode .np-only { display: none; }
  .grid-fp-only { display: none; }
  body.fp-mode .grid-fp-only { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--surfaceB); }
  ::-webkit-scrollbar-thumb { background: var(--borderB); border-radius: 3px; }

  /* ─────────────────────────────────────────────────────────────
     IRONFEAST SITE CHROME
     Copied from public/index.ejs rather than shared, deliberately:
     keeps this page from depending on the homepage stylesheet.
     Every selector is namespaced .site-* so nothing here can
     collide with the builder's own .header / .footer rules above.
     Colors are literal because the builder's :root does not
     define the homepage's custom properties.
     ───────────────────────────────────────────────────────────── */
  .site-header {
    background-color: #2c3e50;
    color: #ecf0f1;
    padding: 1rem 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }
  .site-nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .site-logo {
    font-size: 1.8rem;
    font-weight: 700;
    color: #ecf0f1;
    text-decoration: none;
    line-height: 1.2;
  }
  .site-nav-links {
    display: flex;
    gap: 25px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .site-nav-links a {
    text-decoration: none;
    color: #ecf0f1;
    font-weight: 500;
    transition: color 0.3s ease;
  }
  .site-nav-links a:hover,
  .site-nav-links a:focus-visible {
    color: #3498db;
  }
  .site-nav-links a[aria-current="page"] {
    color: #3498db;
    border-bottom: 2px solid #3498db;
    padding-bottom: 2px;
  }

  .site-cta {
    max-width: 860px;
    margin: 48px auto 0;
    padding: 30px 26px;
    text-align: center;
    background: var(--surface, #ffffff);
    border: 1px solid var(--border, #dce2ee);
    border-radius: 12px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }
  .site-cta h2 {
    font-size: 1.35rem;
    color: #1e2a3a;
    margin: 0 0 8px;
  }
  .site-cta p {
    color: #52647a;
    margin: 0 0 20px;
    line-height: 1.6;
  }
  .site-cta-btn {
    display: inline-block;
    background-color: #e74c3c;
    color: #fff;
    padding: 12px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }
  .site-cta-btn:hover,
  .site-cta-btn:focus-visible {
    background-color: #c0392b;
  }

  .site-footer {
    text-align: center;
    padding: 20px;
    background-color: #2c3e50;
    color: #ecf0f1;
    margin-top: 40px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }
  .site-footer p { margin: 0; }

  @media (max-width: 600px) {
    .site-nav-inner { justify-content: center; text-align: center; }
    .site-nav-links { gap: 16px; justify-content: center; }
    .site-logo { font-size: 1.45rem; }
  }
</style>
</head>
<body>

<!-- ── IRONFEAST SITE CHROME ── -->
<header class="site-header">
  <div class="site-nav-inner">
    <a href="<%= siteBase %>/" class="site-logo">Ironfeast Consulting</a>
    <nav aria-label="Main">
      <ul class="site-nav-links">
        <li><a href="<%= siteBase %>/#overview">Overview</a></li>
        <li><a href="<%= siteBase %>/#about">About Us</a></li>
        <li><a href="<%= siteBase %>/#sbir">SBIR Info</a></li>
        <li><a href="<%= siteBase %>/grant-builder" aria-current="page">Grant Builder</a></li>
        <li><a href="<%= siteBase %>/#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<!-- ── HEADER ── -->
<div class="header">
  <div class="header-inner">
    <div class="eyebrow" id="hdr-eyebrow">Grant research · v3.0</div>
    <h1>Grant Opportunity <span>Prompt Builder</span></h1>
    <p id="hdr-desc">Tell us about your organization and we will write the prompt for you. Paste it into whichever AI you already use and you get back a ranked list of funders worth your time.</p>
    <div class="hbadges">
      <span class="hbadge">🎭 Role Framing</span>
      <span class="hbadge">🧠 Chain-of-Thought</span>
      <span class="hbadge">✅ Verification Step</span>
      <span class="hbadge">🆕 2026 Categories</span>
    </div>
  </div>
</div>

<!-- ── ORG TYPE TOGGLE ── -->
<div class="mode-toggle-wrap">
  <div style="display:flex;align-items:center;gap:0;flex-wrap:wrap;row-gap:10px;">
    <div class="mode-toggle">
      <button class="mode-btn active-np" id="btn-np" onclick="setMode('np')">🏛️ Nonprofit</button>
      <button class="mode-btn" id="btn-fp" onclick="setMode('fp')">🏢 For-Profit</button>
    </div>
    <span class="mode-label" id="mode-label">Foundations, government, corporate grants &amp; giving programs</span>
  </div>
</div>

<div class="main">

  <!-- Tabs -->
  <div class="tabs">
    <button class="tab-btn active" onclick="showTab('build',this)">📝 Build Prompt</button>
    <button class="tab-btn" onclick="showTab('prompt',this)">✨ Generated Prompt</button>
    <button class="tab-btn" onclick="showTab('guide',this)">💡 How to Use</button>
  </div>

  <!-- ══ BUILD TAB ══ -->
  <div id="tab-build">

    <!-- ── ORGANIZATION BASICS ── -->
    <div class="section">
      <div class="section-head"><span>🏢</span><span class="section-title" id="sec-basics-title">Organization Basics</span></div>
      <div class="section-body">
        <div class="grid-2">
          <div class="field">
            <label>Organization Name</label>
            <div class="hint">Optional — personalizes the prompt</div>
            <input type="text" id="orgName" placeholder="e.g. Riverside Youth Alliance">
          </div>
          <!-- NP: tax status | FP: business structure -->
          <div class="field np-only">
            <label>Tax-Exempt Status</label>
            <select id="taxStatus">
              <option value="501(c)(3)">501(c)(3) — Public Charity</option>
              <option value="501(c)(3) Private Foundation">501(c)(3) — Private Foundation</option>
              <option value="501(c)(4)">501(c)(4) — Social Welfare</option>
              <option value="Fiscally Sponsored">Fiscally Sponsored</option>
              <option value="In process / Pending">In process / Pending</option>
            </select>
          </div>
          <div class="field fp-only">
            <label>Business Structure</label>
            <select id="bizStructure">
              <option value="LLC">LLC</option>
              <option value="C-Corporation">C-Corporation</option>
              <option value="S-Corporation">S-Corporation</option>
              <option value="B-Corporation (Benefit Corp)">B-Corporation (Benefit Corp)</option>
              <option value="Sole Proprietorship">Sole Proprietorship</option>
              <option value="Partnership">Partnership</option>
              <option value="Cooperative">Cooperative</option>
            </select>
          </div>
        </div>

        <!-- NP: mission | FP: business description -->
        <div class="field np-only">
          <label>Mission Statement</label>
          <div class="hint">1–2 sentences using funder language, not internal jargon</div>
          <textarea id="mission" rows="2" placeholder="e.g. We provide after-school STEM and mentorship to underserved youth in urban communities."></textarea>
        </div>
        <div class="field fp-only">
          <label>Business Description &amp; Value Proposition</label>
          <div class="hint">What you do, what problem you solve, and what makes your approach distinctive</div>
          <textarea id="bizDesc" rows="2" placeholder="e.g. We develop AI-powered diagnostic tools for rural primary care clinics, reducing misdiagnosis rates by 40%."></textarea>
        </div>

        <div class="grid-3">
          <div class="field">
            <label>Years Operating</label>
            <input type="text" id="orgAge" placeholder="e.g. 3">
          </div>
          <div class="field">
            <label id="lbl-phase">Organizational Phase</label>
            <select id="orgPhase">
              <option value="pre-revenue startup">Pre-Revenue Startup</option>
              <option value="early-stage with some revenue">Early-Stage (some revenue)</option>
              <option value="growth stage" selected>Growth Stage</option>
              <option value="mature / established">Mature / Established</option>
            </select>
          </div>
          <div class="field">
            <label id="lbl-budget">Annual Revenue / Budget (USD)</label>
            <input type="text" id="budget" placeholder="e.g. 500,000">
          </div>
        </div>

        <div class="grid-2">
          <div class="field">
            <label>Staff / Team Size</label>
            <select id="staffSize">
              <option value="">Select…</option>
              <option value="1 (founder only)">Just me / Founder</option>
              <option value="2–5">2–5</option>
              <option value="6–15">6–15</option>
              <option value="16–50">16–50</option>
              <option value="50+">50+</option>
            </select>
          </div>
          <!-- NP only: fiscal sponsor -->
          <div class="field np-only">
            <label>Fiscal Sponsor Status</label>
            <select id="fiscalSponsor">
              <option value="no">Not fiscally sponsored</option>
              <option value="yes">Yes — fiscally sponsored</option>
              <option value="transitioning">In transition</option>
            </select>
          </div>
          <!-- FP only: ownership -->
          <div class="field fp-only">
            <label>Ownership / Founder Background</label>
            <select id="ownership">
              <option value="">Select…</option>
              <option value="Women-owned (WOSB)">Women-owned (WOSB)</option>
              <option value="Minority-owned (MBE)">Minority-owned (MBE)</option>
